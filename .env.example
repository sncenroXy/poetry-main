# ===== 服务器部署环境变量 =====
# 复制此文件为 .env 并填写实际值
# Web 端口（Nginx 对外暴露的端口）
WEB_PORT=80

# ===== 安全配置 =====
# 非空时，AI 接口（生成/图像/视频/助手/意象）需要请求头 X-API-Key 校验
# 前端需在 frontend/.env.production 中设置同名的 VITE_API_KEY
APP_API_KEY=
# 跨域白名单（逗号分隔）；Docker 部署走 Nginx 同源，默认即可
CORS_ORIGINS=http://localhost:5173
# 限流（次/分钟/IP）：AI 文本接口 / 图视频接口
AI_RATE_LIMIT_PER_MINUTE=30
MEDIA_RATE_LIMIT_PER_MINUTE=10

# MongoDB（容器内部通信，一般不需要修改）
MONGODB_URI=mongodb://mongo:27017
DATABASE_NAME=poetrydb

# LLM 配置（兼容 OpenAI 格式，支持中转站/NewAPI/OneAPI）
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 图像生成 API（OpenAI 兼容，如 智谱）
IMAGE_API_KEY=your-image-api-key
IMAGE_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
IMAGE_MODEL=Cogview-3-Flash
IMAGE_SIZE=1024x1024

# 视觉模型 API（支持多模态，如 GPT-4o）
VISION_API_KEY=your-vision-api-key
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o

# 视频生成 API（智谱 CogVideoX）
VIDEO_API_KEY=your-video-api-key
VIDEO_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
VIDEO_MODEL=cogvideox-flash
